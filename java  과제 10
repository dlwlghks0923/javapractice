public class new20260916 {
    public static void main(String[] args) {
        
        System.out.println("=== 연산자(2) 예시 ===");
        int x = 10;
        int y = 3;
        System.out.println("x = 10, y = 3 일 때");
        System.out.println("x + y = " + (x + y));
        System.out.println("x - y = " + (x - y));
        System.out.println("x * y = " + (x * y));
        System.out.println("x / y = " + (x / y));
        System.out.println("x % y = " + (x % y));
        
        System.out.println(); // 콘솔창 한 줄 띄우기

        System.out.println("=== 1000초를 분과 초로 변환 ===");
        int secondVar = 1000;              // 입력 초[cite: 17]
        int minOut = secondVar / 60;       // 분 계산[cite: 17]
        int secondOut = secondVar % 60;    // 남은 초 계산[cite: 17]
        
        System.out.println(secondVar + "초는 " + minOut + "분 " + secondOut + "초 입니다.");
    }
}
